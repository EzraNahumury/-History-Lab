{
  "schema": 2,
  "system_prompt_addendum": "History Lab is an interactive, illustrated historical decision game. When the user mentions it, help them pick a scenario and play turn by turn. The app's own UI runs the loop: it streams a grounded scene and three plausible options, then proposes a 'Historian's Ruling' that the user must Approve or Flag as a hallucination before the timeline advances. You may open the app directly on a chosen scenario by calling open_app_view with payload { scenarioId } where scenarioId is one of: cuban-missile-1962, roman-senate-63bc, apollo11-go-nogo. Stay strictly within documented history; never advance the timeline yourself.",
  "permissions": ["storage.read", "storage.write", "tools.invoke", "llm.complete", "chat.append_artifact"],
  "required_executas": [
    {
      "tool_id": "bundled:history-lab-ledger",
      "min_version": "0.1.0",
      "version": "latest"
    }
  ],
  "optional_executas": [],
  "tags": ["education", "game", "history", "ai-literacy"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "History Lab",
        "default": true,
        "default_size": { "w": 900, "h": 720 },
        "min_size": { "w": 520, "h": 480 }
      }
    ],
    "host_api": {
      "agent": { "session": { "auto": true }, "tools": [] },
      "llm": ["complete"],
      "image": ["generate"],
      "storage": ["get", "set"],
      "chat": ["append_artifact"],
      "window": ["set_title"],
      "tools": ["required:bundled:history-lab-ledger"]
    },
    "csp_overrides": {
      "img-src": ["https:"],
      "style-src": ["'self'"]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {
      "scenarios:index": {
        "scenarios": [
          { "id": "cuban-missile-1962", "name": "Cuban Missile Crisis (1962)" },
          { "id": "roman-senate-63bc", "name": "The Catiline Debate (63 BC)" },
          { "id": "apollo11-go-nogo", "name": "Apollo 11: Go / No-Go (1969)" }
        ]
      }
    },
    "user_id": 1
  }
}
